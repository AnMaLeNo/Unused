{
  "tasksDir": "./tasks",
  "dataDir": "./data",
  "claude": {
    "sessionArgs": [
      "--output-format",
      "json",
      "--no-session-persistence",
      "--dangerously-skip-permissions"
    ]
  },
  "docker": {
    "baseImage": "unused-base",
    "dockerfileDir": "./docker",
    "flattenAfterLayers": 30
  },
  "scheduler": {
    "backoffMinutes": 15,
    "maxConsecutiveFailures": 3
  }
}
